{
  "name": "@qrypto/mock-server",
  "version": "0.2.0",
  "description": "Standalone exchange mock server — zero Docker, starts in under 3 seconds",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "qrypto-mock": "./dist/bin/start.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "ts-node --esm src/index.ts",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@qrypto/shared-types": "*",
    "express": "^4.19.2",
    "ws": "^8.18.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/ws": "^8.5.11",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.5.3"
  }
}
