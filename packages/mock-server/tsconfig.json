{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "@qrypto/shared-types": ["../shared-types/src/index.ts"],
      "@qrypto/shared-types/*": ["../shared-types/src/*"]
    }
  },
  "references": [
    { "path": "../shared-types" }
  ],
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"]
}