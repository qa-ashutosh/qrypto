{
  "name": "@qrypto/compliance",
  "version": "0.6.0",
  "private": true,
  "description": "BDD compliance suite — Cucumber + Gherkin, dual Allure + HTML reports, zero retries",
  "scripts": {
    "test": "cucumber-js",
    "report:allure": "allure generate allure-results --clean -o allure-report",
    "report:html": "node scripts/generate-html-report.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@qrypto/shared-types": "*"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^10.8.0",
    "@cucumber/pretty-formatter": "^1.0.1",
    "allure-cucumberjs": "^3.0.0",
    "typescript": "^5.5.3",
    "ts-node": "^10.9.2"
  }
}
