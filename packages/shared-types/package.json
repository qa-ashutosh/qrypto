{
  "name": "@qrypto/shared-types",
  "version": "0.1.0",
  "description": "Shared domain types, Zod schemas, test factories, and utilities for the qrypto QA platform",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./types": {
      "require": "./dist/types/index.js",
      "import": "./dist/types/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./schemas": {
      "require": "./dist/schemas/index.js",
      "import": "./dist/schemas/index.js",
      "types": "./dist/schemas/index.d.ts"
    },
    "./factories": {
      "require": "./dist/factories/index.js",
      "import": "./dist/factories/index.js",
      "types": "./dist/factories/index.d.ts"
    },
    "./utils/*": {
      "require": "./dist/utils/*.js",
      "import": "./dist/utils/*.js",
      "types": "./dist/utils/*.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "decimal.js": "^10.4.3",
    "zod": "^3.23.8",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/uuid": "^10.0.0",
    "typescript": "^5.5.3"
  }
}